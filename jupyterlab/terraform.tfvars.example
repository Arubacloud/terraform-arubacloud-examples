# ── ArubaCloud credentials ────────────────────────────────────────────────────
arubacloud_client_id     = "your-oauth2-client-id"
arubacloud_client_secret = "your-oauth2-client-secret"

# ── SSH access ────────────────────────────────────────────────────────────────
ssh_public_key = "ssh-ed25519 AAAA... user@host"

# Restrict SSH to your IP in production (recommended)
# ssh_cidr = "203.0.113.42/32"

# ── JupyterLab ───────────────────────────────────────────────────────────────
# Password for the JupyterLab web interface (min 8 chars).
jupyter_password = "change-me-strong-password"

# Optional: set a domain to enable automatic ACME HTTPS.
# The domain must resolve to the VM's Elastic IP before terraform apply.
# domain = "notebooks.example.com"

# ── Infrastructure (optional overrides) ───────────────────────────────────────
# app_name        = "jupyter"
# environment     = "prod"
# location        = "ITBG-Bergamo"
# zone            = "ITBG-1"
# vm_flavor       = "CSO2A4"
# vm_disk_size_gb = 40
# billing_period  = "Hour"
