# ── ArubaCloud credentials ────────────────────────────────────────────────────
arubacloud_client_id     = "your-oauth2-client-id"
arubacloud_client_secret = "your-oauth2-client-secret"

# ── SSH access ────────────────────────────────────────────────────────────────
ssh_public_key = "ssh-ed25519 AAAA... user@host"

# Restrict SSH to your IP in production (recommended)
# ssh_cidr = "203.0.113.42/32"

# ── Database ─────────────────────────────────────────────────────────────────
# MySQL password for the Superset metadata DB user (min 8 chars).
db_password = "change-me-db-password"

# ── Superset ─────────────────────────────────────────────────────────────────
# Admin credentials for the initial Superset account.
admin_password = "change-me-admin-password"
admin_email    = "admin@example.com"

# Optional: set a domain to enable automatic ACME HTTPS.
# The domain must resolve to the VM's Elastic IP before terraform apply.
# domain = "bi.example.com"

# ── Infrastructure (optional overrides) ───────────────────────────────────────
# app_name         = "superset"
# environment      = "prod"
# location         = "ITBG-Bergamo"
# zone             = "ITBG-1"
# vm_flavor        = "CSO4A8"
# vm_disk_size_gb  = 40
# billing_period   = "Hour"
# dbaas_flavor     = "DBO2A8"
# db_storage_gb    = 20
# superset_version = "4.1.1"
